---
import ynhLogo from '../assets/ynh_logo_white.svg';
---

<header>
    <span class="site-title">
        <img src={ynhLogo.src} alt="YunoHost Logo"/>
        YunoHost Analytics
    </span>
</header>

<style>
    header {
        padding: 2rem;
        color: white;
    }

    .site-title {
        gap: 1rem;
        display: flex;
        align-items:center;
        font-weight: 700;
        font-size: 2em;
    }

    .site-title img {
        height: 2em;
    }
</style>
